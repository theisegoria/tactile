[configuration]
entry_symbol = "tactile_library_init"
compatibility_minimum = "4.3"

[libraries]
macos.debug = "res://bin/libtactile_godot.macos.template_debug.dylib"
macos.release = "res://bin/libtactile_godot.macos.template_release.dylib"

[dependencies]
macos.debug = { "res://bin/libCTactile.dylib" : "" }
macos.release = { "res://bin/libCTactile.dylib" : "" }
