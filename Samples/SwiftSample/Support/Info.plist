<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>dev.tactile.demo</string>
    <key>CFBundleName</key>
    <string>Tactile Demo</string>
    <key>CFBundleExecutable</key>
    <string>TactileDemo</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Only needed for audio-reactive haptics from the microphone. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Tactile Demo turns microphone audio into controller haptics when you enable “Mic haptics”.</string>
    <!-- Shown if the app triggers Bluetooth access (sandboxed builds). -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Tactile Demo talks to your DualSense controller over Bluetooth.</string>
</dict>
</plist>
